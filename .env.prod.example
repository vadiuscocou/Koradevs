# Copie ce fichier en « .env.prod » sur le serveur et remplis les valeurs. Ne le mets jamais sur GitHub.

# Mot de passe de la base (choisis-en un long et au hasard).
POSTGRES_PASSWORD=change-moi

# Nom de domaine pour avoir le https (exemple : koradevs.sn). Sans domaine, laisse vide.
SITE=

# Adresse publique du site, sans « / » à la fin (exemple : https://koradevs.sn ou http://41.0.0.1).
SOS_WEB_URL=http://adresse-du-serveur

# Utilise la base gérée de Systalink à la place de la base du serveur : décommente et remplis.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom

# Connexion GitHub et Google (facultatif, voir le README).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
