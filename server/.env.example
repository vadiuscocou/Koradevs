# Copie ce fichier en server/.env (jamais commité) ou exporte ces variables.
PORT=4000
DATABASE_URL=postgres://sos:sos@localhost:5432/sos
# Client ID d'une OAuth App GitHub avec « Device Flow » activé (pas un secret).
GITHUB_CLIENT_ID=Ov23lir5dG6Zl7Phqzjl
# Secret de la même OAuth App : seulement pour le bouton « Continuer avec GitHub » du site (jamais commité).
GITHUB_CLIENT_SECRET=
# Connexion Google (client OAuth d'un projet Google Cloud). Le secret n'est jamais commité.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 0 = désactive la création de compte et la connexion par e-mail.
SOS_PASSWORD_AUTH=1
# 1 = accepte « sos login --dev <pseudo> ». Actif par défaut hors production.
SOS_DEV_AUTH=1  # développement local uniquement : toujours ignoré en production
SOS_REQUEST_TTL_HOURS=24
SOS_MAX_REQUESTS_PER_HOUR=3
# Radar : élargissement aux technos proches, puis file publique (en secondes).
SOS_WIDEN_AFTER_SECONDS=120
SOS_PUBLIC_AFTER_SECONDS=300
# Adresse de l'interface web (lien vers la salle SOS affiché dans le terminal).
SOS_WEB_URL=http://localhost:5173
